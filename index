            function renderAscii(time) {
                offCtx.fillStyle = '#000';
                offCtx.fillRect(0, 0, w, h);
                const t = time * 0.001; 
                
                offCtx.fillStyle = '#C5F03A'; 
                offCtx.beginPath();
                offCtx.arc(w/2 + Math.sin(t)*120, h/2 + Math.cos(t*1.3)*80, 150, 0, Math.PI*2);
                offCtx.fill();
                
                offCtx.fillStyle = '#FF3366'; 
                offCtx.beginPath();
                offCtx.arc(w/2 + Math.cos(t*0.8)*140, h/2 + Math.sin(t*1.1)*100, 120, 0, Math.PI*2);
                offCtx.fill();

