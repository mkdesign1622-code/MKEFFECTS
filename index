            let w, h;
            const cellSize = 16; 
            
            function initAscii() {
                w = asciiWrap.clientWidth;
                h = asciiWrap.clientHeight;
                asciiCanvas.width = w;
                asciiCanvas.height = h;
                offCanvas.width = w;
                offCanvas.height = h;
