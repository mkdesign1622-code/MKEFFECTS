            'trail': `/* JS Logic */\nconst wrap = document.getElementById('trail-wrap');\nconst colors = ['#222', '#444', '#666'];\nlet lastX=0, lastY=0, idx=0;\nfunction spawnBox(x, y) {\n  const r = wrap.getBoundingClientRect();\n  const dx = x - r.left, dy = y - r.top;\n  if(Math.hypot(dx - lastX, dy - lastY) < 40) return;\n  lastX = dx; lastY = dy;\n  const b = document.createElement('div');\n  b.className = 'trail-box';\n  b.style.background = colors[idx++ % colors.length];\n  b.style.left = dx + 'px'; b.style.top = dy + 'px';\n  wrap.appendChild(b);\n  setTimeout(() => b.remove(), 1000);\n}\nwrap.addEventListener('mousemove', e => spawnBox(e.clientX, e.clientY));`,
