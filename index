<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MKEFFECTS</title>
    
    <!-- Строго Pretendard -->
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    
    <style>
        :root {
            --bg: #050505;
            --surface: #111111;
            --border: #222222;
            --text-main: #FFFFFF;
            --text-muted: #7A7A7A;
            --font-main: 'Pretendard', sans-serif;
            --ease: cubic-bezier(0.16, 1, 0.3, 1);
            --radius: 24px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg);
            color: var(--text-main);
            font-family: var(--font-main);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        /* SVG-фильтр потекших чернил */
        .ink-bleed {
            filter: url('#ink-filter');
            letter-spacing: -0.02em;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 5%;
        }

        /* HEADER (ОТЦЕНТРИРОВАН) */
        header {
            padding: 100px 0 40px;
            text-align: center;
        }
        
        .hero-title {
            font-size: clamp(3rem, 7vw, 6rem);
            font-weight: 600;
            line-height: 1;
            margin-bottom: 40px;
            text-transform: uppercase;
        }

        /* ФИЛЬТРЫ И ПОИСК (ОТЦЕНТРИРОВАНЫ) */
        .filters-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
            padding-bottom: 40px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 40px;
        }

        .filters {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-muted);
            padding: 12px 24px;
            border-radius: 100px;
            font-family: var(--font-main);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-btn:hover { border-color: #666; color: #FFF; }
        .filter-btn.active { background: #FFF; color: #000; border-color: #FFF; }

        .search-input {
            background: transparent;
            border: 1px solid var(--border);
            color: #FFF;
            padding: 14px 24px;
            border-radius: 100px;
            font-family: var(--font-main);
            font-size: 15px;
            width: 100%;
            max-width: 400px;
            outline: none;
            transition: border-color 0.3s ease;
        }
        .search-input:focus { border-color: #666; }
        .search-input::placeholder { color: var(--text-muted); }

        /* КАТАЛОГ */
        .list-section {
            display: flex;
            flex-direction: column;
        }

        .list-item {
            display: flex;
            align-items: stretch;
            justify-content: space-between;
            padding: 40px 0 80px 0;
            border-bottom: 1px solid var(--border);
            gap: 60px;
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .item-info {
            flex: 0 0 380px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .item-info h2 { font-size: 32px; font-weight: 600; margin-bottom: 16px; }
        .item-info p { color: var(--text-muted); font-size: 15px; line-height: 1.5; margin-bottom: 24px; }

        .params-list {
            list-style: none;
            margin-bottom: 40px;
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            padding: 20px;
            border-radius: 8px;
        }
        
        .params-title { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: #FFF; margin-bottom: 12px; font-weight: 600; }
        .params-list li { font-size: 14px; color: #999; margin-bottom: 12px; padding-left: 16px; position: relative; }
        .params-list li::before { content: "•"; position: absolute; left: 0; color: #555; }
        .params-list code { background: #222; color: #FFF; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-size: 13px; }

        .item-preview {
            flex: 1;
            min-height: 500px;
            background-color: var(--surface);
            border-radius: var(--radius);
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border);
        }

        .copy-btn {
            background-color: #FFFFFF;
            color: #000000;
            border: none;
            padding: 16px 32px;
            border-radius: 8px;
            font-family: var(--font-main);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            align-self: flex-start;
        }
        .copy-btn:hover { transform: translateY(-2px); }
        .copy-btn.copied-state { background-color: #2A2A2A !important; color: #888888 !important; transform: translateY(0); pointer-events: none; }

        .toast {
            position: fixed;
            bottom: 40px;
            left: 50%;
            transform: translate(-50%, 100px);
            background: #FFFFFF;
            color: #000000;
            padding: 16px 32px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 14px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.4);
            opacity: 0;
            z-index: 9999;
            transition: all 0.4s var(--ease);
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .toast.show { transform: translate(-50%, 0); opacity: 1; }

        footer { padding: 60px 0; text-align: center; color: var(--text-muted); font-size: 14px; font-weight: 500; }

        /* =========================================
           ЭФФЕКТЫ (1-22) 
           ========================================= */
        .xray-wrap { width: 100%; height: 100%; background: #C5F03A; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: crosshair; }
        .xray-text { font-size: clamp(40px, 6vw, 80px); font-weight: 800; color: #000; letter-spacing: -0.04em; line-height: 0.9; text-align: center; position: absolute; width: 100%; z-index: 1;}
        .xray-mask-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #000; z-index: 2; clip-path: circle(120px at var(--x, 50%) var(--y, 50%)); transition: clip-path 0.1s; pointer-events: none; display: flex; align-items: center; justify-content: center; }
        .xray-mask-text { font-size: clamp(40px, 6vw, 80px); font-weight: 800; color: #FFF; letter-spacing: -0.04em; line-height: 0.9; text-align: center; position: absolute; width: 100%; }

        .ribbon-wrap { width: 100%; height: 100%; background: #EFEFEF; display: flex; align-items: center; overflow: hidden; position: relative; cursor: grab;}
        .ribbon-track { display: flex; gap: 20px; padding: 0 40px; transform: translateX(calc(var(--scroll, 0) * -1%)); transition: transform 0.8s var(--ease); }
        .ribbon-item { flex: 0 0 280px; height: 380px; border-radius: 12px; background: #CCC; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
        .ribbon-item img { width: 100%; height: 100%; object-fit: cover; }

        .cursor-line-wrap { width: 100%; height: 100%; background: #050505; position: relative; overflow: hidden; cursor: none; display: flex; align-items: center; justify-content: center;}
        .cursor-line-text { font-size: 24px; color: #333; font-weight: 500; pointer-events: none; }
        .cursor-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; }

        .rev-wrap { width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; position: relative; }
        .rev-list { list-style: none; padding: 0 10%; position: relative; z-index: 2; }
        .rev-item { font-size: clamp(32px, 4vw, 56px); font-weight: 500; color: #444; cursor: pointer; transition: color 0.3s; border-bottom: 1px solid #222; padding: 24px 0; line-height: 1; }
        .rev-item:hover { color: #FFF; }
        .rev-floater { position: absolute; width: 280px; height: 380px; border-radius: 16px; pointer-events: none; opacity: 0; transform: translate(-50%, -50%) scale(0.8) rotate(-4deg); transition: transform 0.6s var(--ease), opacity 0.4s var(--ease); z-index: 1; overflow: hidden; }
        .rev-floater.active { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(0deg); }
        .rev-floater img { width: 100%; height: 100%; object-fit: cover; }

        .mag-area { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
        .mag-btn { background: #FFF; color: #000; padding: 20px 50px; border-radius: 80px; font-family: var(--font-main); font-size: 15px; font-weight: 600; border: none; cursor: pointer; transition: transform 0.4s var(--ease); text-transform: uppercase; }
        @media (hover: hover) { .mag-area:hover .mag-btn { transition: none; } }

        .scramble-wrap { font-family: monospace; font-size: clamp(24px, 3vw, 36px); font-weight: 500; color: #FFF; cursor: pointer; letter-spacing: 0.05em; }

        .gooey-wrap { filter: url('#gooey-filter'); display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; position: relative; }
        .gooey-btn { background: #FFF; color: #000; border: none; padding: 20px 50px; font-family: var(--font-main); font-size: 15px; font-weight: 600; border-radius: 80px; position: relative; z-index: 2; pointer-events: none; }
        .gooey-blob { position: absolute; width: 60px; height: 60px; background: #FFF; border-radius: 50%; z-index: 1; transition: transform 0.6s var(--ease); pointer-events: none;}
        .item-preview:hover .gooey-blob:nth-child(2) { transform: translate(-80px, -40px) scale(1.4); }
        .item-preview:hover .gooey-blob:nth-child(3) { transform: translate(80px, 40px) scale(1.2); }

        .inv-card { width: 340px; padding: 60px 40px; background: #000; border: 1px solid #222; border-radius: 16px; transition: all 0.5s ease; cursor: pointer; display: flex; flex-direction: column; justify-content: space-between; height: 340px;}
        .inv-card p { font-size: 13px; color: #666; text-transform: uppercase; letter-spacing: 0.05em; transition: color 0.5s ease; }
        .inv-card h3 { font-size: 32px; font-weight: 500; color: #FFF; transition: color 0.5s ease; line-height: 1.1; letter-spacing: -0.02em;}
        .item-preview:hover .inv-card { background: #FFF; border-color: #FFF; }
        .item-preview:hover .inv-card h3 { color: #000; }
        .item-preview:hover .inv-card p { color: #888; }

        .acc-wrap { display: flex; gap: 10px; width: 90%; height: 240px; }
        .acc-item { flex: 1; background: #222; border-radius: 12px; transition: flex 0.6s var(--ease), background 0.6s ease; cursor: pointer; position: relative; overflow: hidden;}
        .acc-item:nth-child(1) {background: #222;}
        .acc-item:nth-child(2) {background: #333;}
        .acc-item:nth-child(3) {background: #444;}
        .acc-item:hover, .acc-item.active { flex: 3; background: #FFFFFF; }

        .trail-wrap { width: 100%; height: 100%; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; cursor: crosshair; }
        .trail-title { font-size: 36px; font-weight: 600; color: #333; pointer-events: none; z-index: 1; }
        .trail-box { position: absolute; width: 120px; height: 160px; border-radius: 8px; pointer-events: none; transform: translate(-50%, -50%) scale(0.5); opacity: 0; animation: popTrail 1s var(--ease) forwards; z-index: 2; object-fit: cover; }
        @keyframes popTrail { 0% { opacity: 0; transform: translate(-50%, -50%) scale(0.5) rotate(calc(var(--r) * 1deg)); } 20% { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(calc(var(--r) * 1deg)); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(0.8) rotate(calc(var(--r) * 1deg)); } }

        .tilt-wrap { perspective: 1000px; width: 280px; height: 360px; }
        .tilt-card { width: 100%; height: 100%; background: #111; border: 1px solid #333; border-radius: 16px; position: relative; transform-style: preserve-3d; transition: transform 0.1s; display: flex; align-items: center; justify-content: center; cursor: pointer;}
        .tilt-card span { font-size: 24px; font-weight: 600; transform: translateZ(60px); pointer-events: none;}
        .tilt-glare { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 16px; background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.15), transparent 60%); opacity: 0; pointer-events: none; transition: opacity 0.3s; }

        .pixel-wrap { width: 300px; height: 300px; position: relative; background: linear-gradient(135deg, #FF6B6B, #4ECDC4, #FFE66D); border-radius: 12px; overflow: hidden; }
        .pixel-grid { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: grid; grid-template-columns: repeat(10, 1fr); grid-template-rows: repeat(10, 1fr); z-index: 2; }
        .pixel-cell { background: #111; border-right: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05); transition: opacity 0.4s ease; cursor: crosshair; }
        .pixel-cell:hover, .pixel-cell.active { opacity: 0; transition: opacity 0s; }

        .spotlight-wrap { display: flex; justify-content: center; align-items: center; width: 100%; height: 100%; padding: 40px; background: #050505; }
        .spotlight-card { position: relative; width: 320px; height: 320px; background: rgba(255, 255, 255, 0.03); border-radius: 20px; overflow: hidden; display: flex; align-items: center; justify-content: center; cursor: pointer; }
        .spotlight-card::before { content: ""; position: absolute; top: var(--y, -1000px); left: var(--x, -1000px); transform: translate(-50%, -50%); width: 450px; height: 450px; background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 50%); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; }
        .spotlight-card:hover::before { opacity: 1; transition: opacity 0.1s ease; }
        .spotlight-card::after { content: ""; position: absolute; inset: 1px; background: #0a0a0a; border-radius: 19px; z-index: 1; }
        .spotlight-content { position: relative; z-index: 2; text-align: center; color: #FFF; pointer-events: none; }
        .spotlight-content h3 { font-size: 24px; font-weight: 500; margin-bottom: 8px; }
        .spotlight-content p { color: #666; font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em; }

        .noise-wrap { width: 100%; height: 100%; position: relative; overflow: hidden; background: #111; display: flex; align-items: center; justify-content: center; }
        .noise-bg { position: absolute; inset: -50%; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.1'/%3E%3C/svg%3E"); animation: noise-anim 0.2s infinite; pointer-events: none; z-index: 1; }
        .noise-text { font-size: clamp(40px, 6vw, 80px); font-weight: 800; color: #FFF; position: relative; z-index: 2; text-align: center; line-height: 0.9; letter-spacing: -0.04em; pointer-events: none;}
        @keyframes noise-anim { 0% { transform: translate(0,0); } 10% { transform: translate(-5%,-5%); } 20% { transform: translate(-10%,5%); } 30% { transform: translate(5%,-10%); } 40% { transform: translate(-5%,15%); } 50% { transform: translate(-10%,5%); } 60% { transform: translate(15%,0); } 70% { transform: translate(0,10%); } 80% { transform: translate(-15%,0); } 90% { transform: translate(10%,5%); } 100% { transform: translate(5%,0); } }

        .pill-wrap { display: flex; justify-content: center; align-items: center; width: 100%; height: 100%; background: #050505; }
        .pill-nav { --dur: 0.6s; --w: 420px; --bg: #EEEEEE; background: var(--bg); height: 64px; border-radius: 40px; display: flex; align-items: center; padding: 0 24px; width: 140px; overflow: hidden; cursor: pointer; transition: width var(--dur) var(--ease); box-shadow: 0 10px 30px rgba(0,0,0,0.5); position: relative; }
        .pill-nav:hover { width: var(--w); }
        .pill-logo { font-size: 20px; font-weight: 800; color: #111; flex-shrink: 0; letter-spacing: -0.02em; }
        .pill-links { display: flex; gap: 24px; opacity: 0; pointer-events: none; white-space: nowrap; transition: opacity calc(var(--dur) - 0.2s) ease; margin-left: auto; padding-right: 12px; }
        .pill-nav:hover .pill-links { opacity: 1; pointer-events: auto; transition-delay: 0.15s; }
        .pill-link { color: #111; text-decoration: none; font-size: 15px; font-weight: 600; transition: opacity 0.2s; }
        .pill-link:hover { opacity: 0.5; }
        .pill-icon { display: flex; flex-direction: column; gap: 4px; margin-left: auto; flex-shrink: 0; transition: opacity 0.2s ease; }
        .pill-icon-dot { width: 4px; height: 4px; background: #111; border-radius: 50%; }
        .pill-nav:hover .pill-icon { opacity: 0; position: absolute; pointer-events: none; }

        .dir-wrap { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #050505; }
        .dir-link { font-size: clamp(32px, 4vw, 56px); font-weight: 600; color: #FFF; text-decoration: none; position: relative; display: inline-block; letter-spacing: -0.02em; }
        .dir-link::after { content: ''; position: absolute; left: 0; bottom: -4px; width: 100%; height: 2px; background: #FFF; transform: scaleX(0); transform-origin: var(--origin, 50%); transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
        .dir-link:hover::after { transform: scaleX(1); }

        .diff-wrap { position: relative; width: 100%; height: 100%; overflow: hidden; background: #000; display: flex; align-items: center; justify-content: center; }
        .diff-bg-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; transition: transform 0.6s var(--ease); }
        .diff-wrap:hover .diff-bg-img { transform: scale(1.05); }
        .diff-text { position: relative; z-index: 2; font-size: clamp(40px, 8vw, 120px); font-weight: 800; color: #FFF; text-align: center; line-height: 0.9; letter-spacing: -0.02em; text-transform: uppercase; mix-blend-mode: difference; pointer-events: none; }

        .cursor-showcase { position: relative; overflow: hidden; cursor: none; background: #050505; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
        .cursor-showcase * { cursor: none !important; }
        .cc-dot { position: absolute; top: 0; left: 0; width: 12px; height: 12px; margin: -6px 0 0 -6px; background: #C5F03A; border-radius: 50%; pointer-events: none; z-index: 10; transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease; transform: translate(var(--x, -100px), var(--y, -100px)) scale(var(--scale, 1)); }
        .cc-follower { position: absolute; top: 0; left: 0; width: 44px; height: 44px; margin: -22px 0 0 -22px; border: 1px solid rgba(197, 240, 58, 0.6); border-radius: 50%; pointer-events: none; z-index: 9; transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, background 0.3s ease; transform: translate(var(--fx, -100px), var(--fy, -100px)) scale(var(--scale, 1)); }
        .cc-dot.hover { --scale: 0.5; background: #FFF; }
        .cc-follower.hover { --scale: 0.6; border-color: transparent; background: rgba(255,255,255,0.1); }
        .cc-dot.click { --scale: 0.3; }
        .cc-follower.click { --scale: 0.8; background: rgba(255,255,255,0.2); }
        .cc-btn { background: #111; color: #FFF; border: 1px solid #333; padding: 20px 40px; font-size: 16px; font-family: var(--font-main); font-weight: 600; border-radius: 100px; transition: all 0.3s ease; }
        .cc-btn:hover { background: #222; border-color: #555; }

        .dcc-root { position: relative; overflow: hidden; width: 100%; height: 100%; color: #ecebe7; user-select: none; -webkit-user-select: none; touch-action: pan-y; outline: none; -webkit-tap-highlight-color: transparent; --dcc-pad: 24px; --dcc-s: clamp(170px, min(50vmin, 38vw), 420px); --dcc-sheen: 0.6; --dcc-spin: 24s; background: radial-gradient(120% 90% at 50% 40%, #1d1d21, #0b0b0d); border-radius: var(--radius); }
        .dcc-root:focus-visible { box-shadow: inset 0 0 0 2px #171717; }
        .dcc-root[data-dragging], .dcc-root[data-dragging] .dcc-slide { cursor: grabbing; }
        .dcc-stage { position: absolute; left: 50%; top: 52%; width: var(--dcc-s); aspect-ratio: 1/1; transform: translate(-50%, -50%); perspective: calc(var(--dcc-s) * 3.2); }
        .dcc-slide { position: absolute; inset: 0; margin: 0; padding: 0; border: 0; background: none; color: inherit; font: inherit; border-radius: 50%; cursor: pointer; will-change: transform; transform-style: preserve-3d; outline: none; }
        .dcc-tilt { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
        .dcc-slide[data-active] .dcc-tilt { transform: translateZ(var(--dcc-lift, 0px)) rotateX(calc(var(--dcc-py, 0) * -12deg)) rotateY(calc(var(--dcc-px, 0) * 12deg)); }
        .dcc-slide[data-active]:hover { --dcc-lift: calc(var(--dcc-s) * 0.05); }
        .dcc-shade { position: absolute; inset: 0; border-radius: 50%; pointer-events: none; transform: translate3d(0, 7%, -18px) scale(0.97); background: radial-gradient(circle closest-side, transparent 30%, rgba(0,0,0,0.2) 52%, rgba(0,0,0,0.1) 80%, transparent 100%); }
        .dcc-edge, .dcc-disc { position: absolute; inset: 0; border-radius: 50%; -webkit-mask: radial-gradient(circle closest-side, transparent 16.6%, #000 17.1%); mask: radial-gradient(circle closest-side, transparent 16.6%, #000 17.1%); }
        .dcc-edge { transform: translateZ(-4px); background: linear-gradient(160deg, #d7d9dc, #8d9196 55%, #c4c7cb); }
        .dcc-disc { overflow: hidden; background: #cfd2d6; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.28), inset 0 0 0 2px rgba(0,0,0,0.08); }
        .dcc-roll, .dcc-idle { position: absolute; inset: 0; border-radius: 50%; }
        .dcc-roll { transform: rotate(var(--dcc-roll, 0deg)); }
        .dcc-root .dcc-idle { animation: dcc-spin var(--dcc-spin) linear infinite; animation-play-state: paused; }
        .dcc-root .dcc-slide[data-active] .dcc-idle { animation-play-state: running; }
        .dcc-root[data-dragging] .dcc-slide .dcc-idle { animation-play-state: paused; }
        @keyframes dcc-spin { to { transform: rotate(1turn); } }
        .dcc-idle > img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; display: block; object-fit: cover; }
        .dcc-idle > svg, .dcc-hub { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; display: block; overflow: visible; }
        .dcc-hub { pointer-events: none; }
