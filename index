            'spotlight': `/* HTML */\n<div class="spotlight-card">\n  <div class="spotlight-content">Glow</div>\n</div>\n/* CSS */\n.spotlight-card { position: relative; overflow: hidden; background: #111; }\n.spotlight-card::before { content: ""; position: absolute; top: var(--y); left: var(--x); transform: translate(-50%, -50%); width: 400px; height: 400px; background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 50%); opacity: 0; transition: opacity 0.3s; }\n.spotlight-card:hover::before { opacity: 1; }\n.spotlight-card::after { content: ""; position: absolute; inset: 1px; background: #0a0a0a; z-index: 1; }\n.spotlight-content { position: relative; z-index: 2; }\n/* JS */\nconst el = document.querySelector('.spotlight-card');\nel.addEventListener('mousemove', e => { const r = el.getBoundingClientRect(); el.style.setProperty('--x', (e.clientX - r.left)+'px'); el.style.setProperty('--y', (e.clientY - r.top)+'px'); });`,
            'noise': `/* HTML */\n<div class="noise-wrap"><div class="noise-bg"></div></div>\n/* CSS */\n.noise-wrap { position: relative; overflow: hidden; background: #111; }\n.noise-bg { position: absolute; inset: -50%; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.1'/%3E%3C/svg%3E"); animation: noise 0.2s infinite; pointer-events: none; z-index: 1; }\n.noise-text { font-size: clamp(40px, 6vw, 80px); font-weight: 800; color: #FFF; position: relative; z-index: 2; text-align: center; line-height: 0.9; letter-spacing: -0.04em; pointer-events: none;}\n@keyframes noise-anim { 0% { transform: translate(0,0); } 10% { transform: translate(-5%,-5%); } 20% { transform: translate(-10%,5%); } 30% { transform: translate(5%,-10%); } 40% { transform: translate(-5%,15%); } 50% { transform: translate(-10%,5%); } 60% { transform: translate(15%,0); } 70% { transform: translate(0,10%); } 80% { transform: translate(-15%,0); } 90% { transform: translate(10%,5%); } 100% { transform: translate(5%,0); } }`,
            'pillnav': `/* HTML */\n<nav class="pill-nav">\n  <div class="pill-logo">Logo</div>\n  <div class="pill-links">\n    <a href="#" class="pill-link">Work</a>\n    <a href="#" class="pill-link">Studio</a>\n    <a href="#" class="pill-link">Contact</a>\n  </div>\n  <div class="pill-icon"><div class="pill-icon-dot"></div><div class="pill-icon-dot"></div></div>\n</nav>\n/* CSS */\n.pill-nav { --dur: 0.6s; --w: 420px; --bg: #EEEEEE; background: var(--bg); height: 64px; border-radius: 40px; display: flex; align-items: center; padding: 0 24px; width: 140px; overflow: hidden; cursor: pointer; transition: width var(--dur) cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 10px 30px rgba(0,0,0,0.5); position: relative; }\n.pill-nav:hover { width: var(--w); }\n.pill-logo { font-size: 20px; font-weight: 800; color: #111; flex-shrink: 0; letter-spacing: -0.02em; }\n.pill-links { display: flex; gap: 24px; opacity: 0; pointer-events: none; white-space: nowrap; transition: opacity calc(var(--dur) - 0.2s) ease; margin-left: auto; padding-right: 12px; }\n.pill-nav:hover .pill-links { opacity: 1; pointer-events: auto; transition-delay: 0.15s; }\n.pill-link { color: #111; text-decoration: none; font-size: 15px; font-weight: 600; transition: opacity 0.2s; }\n.pill-link:hover { opacity: 0.5; }\n.pill-icon { display: flex; flex-direction: column; gap: 4px; margin-left: auto; flex-shrink: 0; transition: opacity 0.2s ease; }\n.pill-icon-dot { width: 4px; height: 4px; background: #111; border-radius: 50%; }\n.pill-nav:hover .pill-icon { opacity: 0; position: absolute; pointer-events: none; }`,
            'dirUnderline': `/* HTML */\n<a href="#" class="dir-link">Подчеркивание</a>\n/* CSS */\n.dir-link { position: relative; text-decoration: none; display: inline-block; color: #FFF; }\n.dir-link::after { content: ''; position: absolute; left: 0; bottom: -4px; width: 100%; height: 2px; background: #FFF; transform: scaleX(0); transform-origin: var(--origin, 50%); transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }\n.dir-link:hover::after { transform: scaleX(1); }\n/* JS */\ndocument.querySelectorAll('.dir-link').forEach(link => {\n  const updateOrigin = (e) => {\n    const rect = link.getBoundingClientRect();\n    const percent = ((e.clientX - rect.left) / rect.width) * 100;\n    link.style.setProperty('--origin', \`\${percent}%\`);\n  };\n  link.addEventListener('mouseenter', updateOrigin);\n  link.addEventListener('mouseleave', updateOrigin);\n});`,
            'difference': `/* HTML */\n<div class="diff-wrap">\n  <img src="IMG_0036.JPG" class="diff-bg-img" alt="bg">\n  <div class="diff-text">DIFFERENCE</div>\n</div>\n/* CSS */\n.diff-wrap { position: relative; width: 100%; height: 100%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #000; }\n.diff-bg-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; transition: transform 0.6s ease; }\n.diff-wrap:hover .diff-bg-img { transform: scale(1.05); }\n.diff-text { position: relative; z-index: 2; font-size: clamp(40px, 8vw, 120px); font-weight: 800; color: #FFF; text-align: center; line-height: 0.9; letter-spacing: -0.02em; text-transform: uppercase; mix-blend-mode: difference; pointer-events: none; }`,
            'customCursor': `/* HTML */\n<div class="cursor-wrap" id="cursor-wrap">\n  <div class="cc-dot" id="cc-dot"></div>\n  <div class="cc-follower" id="cc-follower"></div>\n  <button class="cc-btn" id="cc-btn">Hover Me</button>\n</div>\n/* CSS */\n.cursor-wrap { position: relative; overflow: hidden; cursor: none; }\n.cursor-wrap * { cursor: none !important; }\n.cc-dot { position: absolute; top: 0; left: 0; width: 12px; height: 12px; margin: -6px 0 0 -6px; background: #C5F03A; border-radius: 50%; pointer-events: none; z-index: 10; transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease; transform: translate(var(--x, -100px), var(--y, -100px)) scale(var(--scale, 1)); }\n.cc-follower { position: absolute; top: 0; left: 0; width: 44px; height: 44px; margin: -22px 0 0 -22px; border: 1px solid rgba(197, 240, 58, 0.6); border-radius: 50%; pointer-events: none; z-index: 9; transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, background 0.3s ease; transform: translate(var(--fx, -100px), var(--fy, -100px)) scale(var(--scale, 1)); }\n.cc-dot.hover { --scale: 0.5; background: #FFF; }\n.cc-follower.hover { --scale: 0.6; border-color: transparent; background: rgba(255,255,255,0.1); }\n.cc-dot.click { --scale: 0.3; }\n.cc-follower.click { --scale: 0.8; background: rgba(255,255,255,0.2); }\n/* JS */\nconst cw = document.getElementById('cursor-wrap'), cd = document.getElementById('cc-dot'), cf = document.getElementById('cc-follower'), cb = document.getElementById('cc-btn');\nlet mx=0, my=0, dx=0, dy=0, fx=0, fy=0;\ncw.addEventListener('mousemove', e => { const r = cw.getBoundingClientRect(); mx = e.clientX - r.left; my = e.clientY - r.top; });\nfunction anim() { dx += (mx - dx) * 0.5; dy += (my - dy) * 0.5; fx += (mx - fx) * 0.15; fy += (my - fy) * 0.15; cd.style.setProperty('--x', \`\${dx}px\`); cd.style.setProperty('--y', \`\${dy}px\`); cf.style.setProperty('--fx', \`\${fx}px\`); cf.style.setProperty('--fy', \`\${fy}px\`); requestAnimationFrame(anim); } anim();\nif(cb) { cb.addEventListener('mouseenter', () => { cd.classList.add('hover'); cf.classList.add('hover'); }); cb.addEventListener('mouseleave', () => { cd.classList.remove('hover'); cf.classList.remove('hover'); cd.classList.remove('click'); cf.classList.remove('click'); }); cb.addEventListener('mousedown', () => { cd.classList.add('click'); cf.classList.add('click'); }); cb.addEventListener('mouseup', () => { cd.classList.remove('click'); cf.classList.remove('click'); }); }`,
            'discCarousel': `/* В HTML блоке выше код уже подробно прописан. Для использования скачайте весь исходный код страницы. Для кастомизации замените ссылки в dccItems. */`,
            'vignetteBloom': `/* HTML */\n<div class="ascii-wrap" id="fx-ascii">\n  <canvas class="ascii-canvas" id="fx-ascii-canvas"></canvas>\n  <div class="ascii-vignette"></div>\n</div>\n/* CSS */\n.ascii-wrap { width: 100%; height: 100%; position: relative; overflow: hidden; background: #000; display: flex; align-items: center; justify-content: center; }\n.ascii-canvas { width: 100%; height: 100%; filter: contrast(1.15) brightness(1.12) drop-shadow(0 0 8px rgba(255,255,255,0.25)); object-fit: cover; }\n.ascii-vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at center, transparent 40%, rgba(0,0,0,0.7) 120%); mix-blend-mode: multiply; z-index: 2; }\n/* JS */\n// Логика программного Wave Mosaic на Canvas 2D находится в исходном коде страницы.`,
            'constellation': `/* HTML */\n<div class="constellation-wrap" id="fx-constellation-wrap">\n    <canvas class="constellation-canvas" id="fx-constellation-canvas"></canvas>\n    <div class="constellation-content">\n        <h1>MAXK.DESIGN</h1>\n    </div>\n</div>\n/* CSS */\n.constellation-wrap { position: relative; width: 100%; height: 100%; background: #050505; overflow: hidden; cursor: crosshair; }\n.constellation-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }\n.constellation-content { position: absolute; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; text-align: center; color: #FFF; pointer-events: none; mix-blend-mode: difference; padding: 20px; }\n.constellation-content h1 { font-family: monospace; font-size: clamp(40px, 6vw, 100px); font-weight: 900; text-transform: uppercase; line-height: 1; margin: 0; letter-spacing: -0.05em; }\n/* JS логика пружин находится в основном коде. */`,
            'morphGallery': `/* В HTML блоке выше код прописан. Подробную WebGL-математику смотрите в исходном коде страницы. Для использования просто скопируйте блок WebGL. */`,
            
            'expandableTabs': `/* HTML */\n<div class="expandable-tabs" id="fx-tabs">\n  <button class="ext-tab active">\n    <svg viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>\n    <span class="ext-tab-title">Dashboard</span>\n  </button>\n  <button class="ext-tab">\n    <svg viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>\n    <span class="ext-tab-title">Notifications</span>\n  </button>\n  <div class="ext-separator"></div>\n  <button class="ext-tab">\n    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>\n    <span class="ext-tab-title">Settings</span>\n  </button>\n</div>\n/* CSS */\n.expandable-tabs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; background: #111; padding: 8px; border-radius: 20px; border: 1px solid #222; }\n.ext-tab { position: relative; display: flex; align-items: center; justify-content: center; border-radius: 14px; border: none; background: transparent; color: #7A7A7A; cursor: pointer; overflow: hidden; transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1); padding: 10px; gap: 0; }\n.ext-tab:hover { color: #FFF; background: #222; }\n.ext-tab.active { color: #111; background: #C5F03A; padding: 10px 18px; gap: 8px; }\n.ext-tab-title { max-width: 0; opacity: 0; white-space: nowrap; font-weight: 600; transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1); }\n.ext-tab.active .ext-tab-title { max-width: 150px; opacity: 1; }\n.ext-separator { width: 1px; height: 24px; background: #333; margin: 0 4px; }\n.ext-tab svg { width: 20px; height: 20px; flex-shrink: 0; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n/* JS */\nconst extTabs = document.querySelectorAll('.ext-tab');\ndocument.addEventListener('click', (e) => {\n  const clickedTab = e.target.closest('.ext-tab');\n  if (clickedTab) {\n    extTabs.forEach(t => t.classList.remove('active'));\n    clickedTab.classList.add('active');\n  } else {\n    extTabs.forEach(t => t.classList.remove('active'));\n  }\n});`
        };

        // ЛОГИКА УВЕДОМЛЕНИЯ ПРИ КОПИРОВАНИИ
        const toast = document.getElementById('toast');
        let toastTimeout;

        function copyCode(effectId, btnElement) {
            const codeToCopy = codeSnippets[effectId];
            
            navigator.clipboard.writeText(codeToCopy).then(() => {
                const originalText = btnElement.innerText;
                btnElement.innerText = "Скопирован код";
                btnElement.classList.add('copied-state');
                toast.classList.add('show');
                
                clearTimeout(toastTimeout);
                toastTimeout = setTimeout(() => { toast.classList.remove('show'); }, 3000);
                setTimeout(() => {
                    btnElement.innerText = originalText;
                    btnElement.classList.remove('copied-state');
                }, 3000);
            }).catch(() => alert('Ошибка доступа к буферу обмена.'));
        }

        // ==========================================
        // ЛОГИКА ФИЛЬТРАЦИИ И ПОИСКА
        // ==========================================
        const searchInput = document.getElementById('search-input');
        const filterBtns = document.querySelectorAll('.filter-btn');
        const rows = document.querySelectorAll('.list-item');

        function applyFilters() {
            const query = searchInput.value.toLowerCase();
            const activeBtn = document.querySelector('.filter-btn.active');
            const activeFilter = activeBtn ? activeBtn.getAttribute('data-filter') : 'all';

            rows.forEach(row => {
                const category = row.getAttribute('data-category') || '';
                const title = row.querySelector('.item-info h2').innerText.toLowerCase();
                
                const matchesFilter = (activeFilter === 'all' || category.includes(activeFilter));
                const matchesSearch = title.includes(query);

                if (matchesFilter && matchesSearch) {
                    row.style.display = 'flex';
                    setTimeout(() => { row.style.opacity = '1'; row.style.transform = 'scale(1)'; }, 10);
                } else {
                    row.style.opacity = '0';
                    row.style.transform = 'scale(0.98)';
                    setTimeout(() => { row.style.display = 'none'; }, 400);
                }
            });
        }

        searchInput.addEventListener('input', applyFilters);

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                applyFilters(); 
            });
        });

        // ==========================================
        // ИНИЦИАЛИЗАЦИЯ ЭФФЕКТОВ (1-22)
        // ==========================================

        // 1. X-RAY REVEAL
        const xWrap = document.getElementById('fx-xray');
        const xMask = document.getElementById('fx-xray-mask');
        if (xWrap && xMask) {
            function moveXRay(e) {
                const r = xWrap.getBoundingClientRect();
                const x = e.touches ? e.touches[0].clientX : e.clientX;
                const y = e.touches ? e.touches[0].clientY : e.clientY;
                xMask.style.setProperty('--x', (x - r.left) + 'px');
                xMask.style.setProperty('--y', (y - r.top) + 'px');
            }
            xWrap.addEventListener('mousemove', moveXRay);
            xWrap.addEventListener('touchmove', moveXRay, {passive: true});
        }

        // 2. RIBBON SLIDER
        const ribWrap = document.getElementById('fx-ribbon');
        const ribTrack = document.getElementById('fx-ribbon-track');
        if (ribWrap && ribTrack) {
            function moveRibbon(e) {
                const r = ribWrap.getBoundingClientRect();
                const x = e.touches ? e.touches[0].clientX : e.clientX;
                const percent = (x - r.left) / r.width;
                ribTrack.style.setProperty('--scroll', (percent * 150));
            }
            ribWrap.addEventListener('mousemove', moveRibbon);
            ribWrap.addEventListener('touchmove', moveRibbon, {passive: true});
            ribWrap.addEventListener('mouseleave', () => ribTrack.style.setProperty('--scroll', 0));
            ribWrap.addEventListener('touchend', () => ribTrack.style.setProperty('--scroll', 0));
        }

        // 3. VELOCITY LINE CURSOR
        const cWrap = document.getElementById('fx-cur-line');
        const canvas = document.getElementById('c-canvas');
        if (cWrap && canvas) {
            const ctx = canvas.getContext('2d');
            let width = cWrap.clientWidth, height = cWrap.clientHeight;
            canvas.width = width; canvas.height = height;

            window.addEventListener('resize', () => {
                width = cWrap.clientWidth; height = cWrap.clientHeight;
                canvas.width = width; canvas.height = height;
            });

            let mouse = { x: width/2, y: height/2 };
            let history = [];
            const maxHistory = 15;

            cWrap.addEventListener('mousemove', e => {
                const r = cWrap.getBoundingClientRect();
                mouse.x = e.clientX - r.left;
                mouse.y = e.clientY - r.top;
            });

            function render() {
                ctx.clearRect(0, 0, width, height);
                history.push({ x: mouse.x, y: mouse.y });
                if (history.length > maxHistory) history.shift();

                if (history.length > 2) {
                    ctx.beginPath();
                    ctx.moveTo(history[0].x, history[0].y);
                    for (let i = 1; i < history.length; i++) {
                        ctx.lineTo(history[i].x, history[i].y);
                    }
                    ctx.strokeStyle = '#FFFFFF';
                    ctx.lineWidth = 2.5;
                    ctx.lineCap = 'round';
                    ctx.lineJoin = 'round';
                    ctx.stroke();
                }
                requestAnimationFrame(render);
            }
            render();
        }

        // 5. ACCORDION
        const accTriggers = document.querySelectorAll('.fx-acc');
        accTriggers.forEach(acc => {
            acc.addEventListener('click', () => {
                accTriggers.forEach(a => a.classList.remove('active'));
                acc.classList.add('active');
            });
        });

        // 6. MOUSE IMAGE TRAIL
        const trailWrap = document.getElementById('fx-trail');
        if(trailWrap) {
            const colors = ['#222222', '#444444', '#666666'];
            let lastX = 0, lastY = 0, boxIndex = 0;
            function spawnTrailBox(clientX, clientY) {
                const rect = trailWrap.getBoundingClientRect();
                const x = clientX - rect.left; const y = clientY - rect.top;
                if(Math.hypot(x - lastX, y - lastY) < 40) return;
                lastX = x; lastY = y;
                const box = document.createElement('div');
                box.className = 'trail-box';
                box.style.background = colors[boxIndex++ % colors.length];
                box.style.left = x + 'px'; box.style.top = y + 'px';
                box.style.setProperty('--r', Math.random() * 30 - 15);
                trailWrap.appendChild(box);
                setTimeout(() => { box.remove(); }, 1000);
            }
            trailWrap.addEventListener('mousemove', (e) => spawnTrailBox(e.clientX, e.clientY));
            trailWrap.addEventListener('touchmove', (e) => spawnTrailBox(e.touches[0].clientX, e.touches[0].clientY), {passive: true});
        }

        // 7. 3D TILT
        const tiltWrap = document.getElementById('fx-tilt-wrap');
        const tiltCard = document.getElementById('fx-tilt-card');
        const tiltGlare = document.getElementById('tilt-glare');
        if(tiltWrap) {
            function handleTiltMove(e) {
                const rect = tiltWrap.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                const mouseX = clientX - (rect.left + rect.width / 2);
                const mouseY = clientY - (rect.top + rect.height / 2);
                tiltCard.style.transform = `rotateX(${-(mouseY / 15)}deg) rotateY(${mouseX / 15}deg)`;
                tiltGlare.style.opacity = '1';
                const px = ((clientX - rect.left) / rect.width) * 100, py = ((clientY - rect.top) / rect.height) * 100;
                tiltGlare.style.background = `radial-gradient(circle at ${px}% ${py}%, rgba(255,255,255,0.15), transparent 60%)`;
            }
            const resetTilt = () => { tiltCard.style.transform = `rotateX(0deg) rotateY(0deg)`; tiltGlare.style.opacity = '0'; };
            tiltWrap.addEventListener('mousemove', handleTiltMove); tiltWrap.addEventListener('touchmove', handleTiltMove, {passive: true});
            tiltWrap.addEventListener('mouseleave', resetTilt); tiltWrap.addEventListener('touchend', resetTilt);
        }

        // 8. PIXEL REVEAL MOSAIC
        const pGrid = document.getElementById('fx-pixel');
        if (pGrid) {
            for(let i=0; i<100; i++) {
                const c = document.createElement('div');
                c.className = 'pixel-cell';
                c.addEventListener('mouseenter', () => c.style.opacity = '0');
                c.addEventListener('mouseleave', () => setTimeout(() => c.style.opacity = '1', 1000));
                c.addEventListener('touchstart', () => c.style.opacity = '0', {passive: true});
                c.addEventListener('touchend', () => setTimeout(() => c.style.opacity = '1', 1000));
                pGrid.appendChild(c);
            }
        }

        // Hover Image Reveal JS
        const rWrap = document.getElementById('rev-wrap');
        const rFloater = document.getElementById('rev-floater');
        const rImg = document.getElementById('rev-img');
        if (rWrap && rFloater) {
            function moveReveal(e) {
                const r = rWrap.getBoundingClientRect();
                const x = e.touches ? e.touches[0].clientX : e.clientX;
                const y = e.touches ? e.touches[0].clientY : e.clientY;
                rFloater.style.left = (x - r.left) + 'px';
                rFloater.style.top = (y - r.top) + 'px';
            }
            rWrap.addEventListener('mousemove', moveReveal);
            rWrap.addEventListener('touchmove', moveReveal, {passive: true});

            document.querySelectorAll('.rev-item').forEach(item => {
                const triggerIn = () => { rImg.src = item.dataset.img; rFloater.classList.add('active'); };
                const triggerOut = () => rFloater.classList.remove('active');
                item.addEventListener('mouseenter', triggerIn);
                item.addEventListener('mouseleave', triggerOut);
            });
        }

        // Magnetic CTA JS
        const mArea = document.getElementById('mag-area');
